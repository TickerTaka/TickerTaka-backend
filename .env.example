# ── Database ─────────────────────────────────────────────
# Local Docker: postgresql+asyncpg://dev:devpass@localhost:5432/tickertaka
# Cloud:        postgresql+asyncpg://USERNAME:PASSWORD@HOST:PORT/DBNAME
# Docker Compose app uses NCP/remote DATABASE_URL as-is; local compose postgres
# is optional and only starts with `--profile local-db`.
DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@HOST:5432/DBNAME

# ── Redis ─────────────────────────────────────────────────
# Host-run backend + local Docker: redis://localhost:6379/0
# Docker Compose app container:  redis://redis:6379/0
# Cloud (with password):         redis://:PASSWORD@HOST:6379/0
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB ──────────────────────────────────────────────
# Host-run backend + local Docker: http://localhost:8080
# Docker Compose app container:     http://chroma:8000
# Cloud:                            http://HOST:8080
CHROMA_URL=http://localhost:8080
CHROMA_TOKEN=

# ── Embedding ─────────────────────────────────────────────
# Docker Compose app mounts a persistent HF cache volume at
# `/root/.cache/huggingface` and sets `HF_HOME` internally.
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
RAG_HYBRID_ENABLED=true
RAG_RRF_K=60
RAG_LEXICAL_CANDIDATE_LIMIT=40
# Optional CrossEncoder reranker. Keep disabled unless you want higher precision
# with additional model load time.
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_TOP_N=8

# ── OpenAI (LLM) ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
# 모델 ID (기본값: gpt-4o-mini)
# BULL_MODEL=gpt-4o-mini
# BEAR_MODEL=gpt-4o-mini
# MODERATOR_MODEL=gpt-4o-mini
# FALLBACK_MODEL=gpt-4o-mini
DEFAULT_LLM_MODEL=openai/gpt-4o-mini
JUDGE_LLM_MODEL=anthropic/claude-haiku-4-5

# ── External APIs ─────────────────────────────────────────
DART_API_KEY=
FILING_INITIAL_LOOKBACK_DAYS=365
FILING_REFRESH_LOOKBACK_DAYS=30
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Local install example:
#   mkdir -p .notion-mcp
#   npm install --prefix .notion-mcp @notionhq/notion-mcp-server
# Then point COMMAND to the installed binary and leave ARGS empty.
NOTION_MCP_SERVER_COMMAND=/abs/path/to/.notion-mcp/node_modules/.bin/notion-mcp-server
NOTION_MCP_SERVER_ARGS=
NOTION_MCP_TOOL_NAME=API-post-page
NOTION_MCP_TIMEOUT_SECONDS=30

# ── LLM Cache ─────────────────────────────────────────────
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=86400

# ── Debate Runtime ────────────────────────────────────────
MAX_TOKENS_PER_USER_PER_DAY=1000000
MAX_DEBATES_PER_USER_PER_DAY=20
DEBATE_ACTIVE_TTL_SECONDS=1800
DEBATE_GRAPH_RECURSION_LIMIT=64
DEFAULT_ESTIMATED_TOKENS_PER_DEBATE=12000
ESTIMATED_TOKENS_FINANCIAL=12000
ESTIMATED_TOKENS_TECHNICAL=10000
ESTIMATED_TOKENS_MARKET=9000
ESTIMATED_TOKENS_MACRO=9000
ESTIMATED_TOKENS_SYNTHESIS=15000

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=your-secret-key-min-32-characters
JWT_EXPIRE_HOURS=24

# ── 감성분석 sLLM (Qwen 보강) ─────────────────────────────
# 미설정이면 룰+FinBERT baseline 만 동작(Qwen 보강 OFF). 설정 시 worker 가 Qwen 보강 수행.
ANALYSIS_GENERATION_MODEL=Qwen/Qwen2.5-1.5B-Instruct
ANALYSIS_ASYNC_ENABLED=True

# ── Langfuse 트레이싱 (선택) ──────────────────────────────
# 키 2개 + ENABLED=True 모두 있어야 활성. 없으면 자동 no-op(운영 영향 0).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=False
# trace 의 service.name 라벨은 코드에서 자동 주입(tickertaka-analysis-worker).
