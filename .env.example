# Local Docker example:
# DATABASE_URL=postgresql://dev:devpass@localhost:5432/tickertaka
# Cloud PostgreSQL example:
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Local Docker example:
# REDIS_URL=redis://localhost:6379/0
# Cloud example (NCP server, Docker self-host with password):
# REDIS_URL=redis://:PASSWORD@HOST:6379/0
# Cloud example (with TLS):
# REDIS_URL=rediss://:PASSWORD@HOST:6379/0?ssl_cert_reqs=none
REDIS_URL=redis://localhost:6379/0

# Local Docker example:
# CHROMA_URL=http://localhost:8080
# Cloud example (NCP server, Docker self-host):
# CHROMA_URL=http://HOST:8080
# CHROMA_TOKEN=  # required if token authn is enabled
# Local Docker image should be pinned to the same major/minor as the Python
# client in requirements.txt to avoid client/server schema drift.
CHROMA_URL=http://localhost:8080
CHROMA_TOKEN=
EMBEDDING_PROVIDER=huggingface

DART_API_KEY=
FILING_INITIAL_LOOKBACK_DAYS=365
FILING_REFRESH_LOOKBACK_DAYS=30
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BULL_MODEL=openrouter/auto
BEAR_MODEL=openrouter/auto
MODERATOR_MODEL=openrouter/auto
FALLBACK_MODEL=openrouter/auto
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=86400
MAX_TOKENS_PER_USER_PER_DAY=1000000
MAX_DEBATES_PER_USER_PER_DAY=20
DEBATE_ACTIVE_TTL_SECONDS=1800
DEBATE_GRAPH_RECURSION_LIMIT=64
DEFAULT_ESTIMATED_TOKENS_PER_DEBATE=12000
ESTIMATED_TOKENS_FINANCIAL=12000
ESTIMATED_TOKENS_TECHNICAL=10000
ESTIMATED_TOKENS_MARKET=9000
ESTIMATED_TOKENS_MACRO=9000
ESTIMATED_TOKENS_SYNTHESIS=15000
OPENAI_API_KEY=
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
DEFAULT_LLM_MODEL=openai/gpt-4o-mini
JUDGE_LLM_MODEL=anthropic/claude-haiku-4-5

JWT_SECRET=
JWT_EXPIRE_HOURS=24
